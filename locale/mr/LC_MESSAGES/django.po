msgid "Admin Login"
msgstr "अॅडमिन लॉगिन"

msgid "Apply Now"
msgstr "आता अर्ज करा"

msgid "Submit"
msgstr "सबमिट"

msgid "Cancel"
msgstr "रद्द करा"

msgid "Apply"
msgstr "अर्ज करा"

msgid "Name must be at least 2 characters long."
msgstr "नाव किमान 2 अक्षरांचे असावे."

msgid "Username is required."
msgstr "युजरनेम आवश्यक आहे."

msgid "This email is already registered."
msgstr "हा ईमेल आधीच नोंदणीकृत आहे."

msgid "This mobile number is already registered."
msgstr "हा मोबाइल क्रमांक आधीच नोंदणीकृत आहे."

msgid "Pincode must be exactly 6 digits."
msgstr "पिनकोड नेमका 6 अंकांचा असावा."

msgid "Date of birth must be in the past."
msgstr "जन्मतारीख भूतकाळातील असावी."

msgid "Switch language"
msgstr "भाषा बदला"

msgid "Verify OTP"
msgstr "OTP पडताळा"

msgid "Verify Your Email"
msgstr "तुमचा ईमेल पडताळा"

msgid "Enter OTP"
msgstr "OTP प्रविष्ट करा"

msgid "OTP expires in"
msgstr "OTP कालबाह्य होईल"

msgid "Didn't receive the OTP?"
msgstr "OTP मिळाला नाही?"

msgid "Resend OTP"
msgstr "OTP पुन्हा पाठवा"

msgid "Resend available after %(seconds)ss"
msgstr "%(seconds)s सेकंदांनंतर पुन्हा पाठवता येईल"

msgid "Need help?"
msgstr "मदत हवी आहे का?"

msgid "Contact Support"
msgstr "समर्थनाशी संपर्क करा"

msgid "Back to Registration"
msgstr "नोंदणीवर परत जा"

msgid "Your data is encrypted and secure. We never share your information."
msgstr "तुमचा डेटा एन्क्रिप्टेड आणि सुरक्षित आहे. आम्ही तुमची माहिती कधीही सामायिक करत नाही."

msgid "Why OTP?"
msgstr "OTP का?"

msgid "OTP ensures only you can access this account"
msgstr "OTP मुळे फक्त तुम्हालाच या खात्यात प्रवेश मिळतो"

msgid "Secure"
msgstr "सुरक्षित"

msgid "Military-grade encryption protects your account"
msgstr "लष्करी दर्जाचे एन्क्रिप्शन तुमचे खाते सुरक्षित ठेवते"

msgid "Quick"
msgstr "जलद"

msgid "OTP is valid for 10 minutes from email delivery."
msgstr "ईमेल पाठवल्यानंतर OTP 10 मिनिटांसाठी वैध आहे."

msgid "You must be at least 18 years old to self-register."
msgstr "स्व-नोंदणीसाठी वय किमान 18 वर्षे असणे आवश्यक आहे."

msgid "Profile photo must be less than 2MB."
msgstr "प्रोफाइल फोटो 2MB पेक्षा कमी असावा."

msgid "Choose a username"
msgstr "युजरनेम निवडा"

msgid "Enter your full name"
msgstr "तुमचे पूर्ण नाव टाका"

msgid "Enter email address"
msgstr "ईमेल पत्ता टाका"

msgid "10-digit mobile number"
msgstr "10 अंकी मोबाइल क्रमांक"

msgid "House no, street, landmark, area"
msgstr "घर क्रमांक, रस्ता, लँडमार्क, परिसर"

msgid "6-digit pincode"
msgstr "6 अंकी पिनकोड"

msgid "Optional 12-digit Aadhaar number"
msgstr "ऐच्छिक 12 अंकी आधार क्रमांक"
