msgstr "क्या आप प्रशासक हैं?"

msgid "Admin Login"
msgstr "एडमिन लॉगिन"

msgid "Apply Now"
msgstr "अभी आवेदन करें"

msgid "Submit"
msgstr "जमा करें"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Apply"
msgstr "आवेदन करें"

msgid "Name must be at least 2 characters long."
msgstr "नाम कम से कम 2 अक्षरों का होना चाहिए।"

msgid "Username is required."
msgstr "यूज़रनेम आवश्यक है।"

msgid "This email is already registered."
msgstr "यह ईमेल पहले से पंजीकृत है।"

msgid "This mobile number is already registered."
msgstr "यह मोबाइल नंबर पहले से पंजीकृत है।"

msgid "Pincode must be exactly 6 digits."
msgstr "पिनकोड ठीक 6 अंकों का होना चाहिए।"

msgid "Date of birth must be in the past."
msgstr "जन्म तिथि भूतकाल की होनी चाहिए।"

msgid "Switch language"
msgstr "भाषा बदलें"

msgid "Verify OTP"
msgstr "OTP सत्यापित करें"

msgid "Verify Your Email"
msgstr "अपना ईमेल सत्यापित करें"

msgid "Enter OTP"
msgstr "OTP दर्ज करें"

msgid "OTP expires in"
msgstr "OTP समाप्त होगा"

msgid "Didn't receive the OTP?"
msgstr "OTP नहीं मिला?"

msgid "Resend OTP"
msgstr "OTP दोबारा भेजें"

msgid "Resend available after %(seconds)ss"
msgstr "%(seconds)s सेकंड बाद दोबारा भेजा जा सकता है"

msgid "Need help?"
msgstr "मदद चाहिए?"

msgid "Contact Support"
msgstr "सहायता से संपर्क करें"

msgid "Back to Registration"
msgstr "पंजीकरण पर वापस जाएं"

msgid "Your data is encrypted and secure. We never share your information."
msgstr "आपका डेटा एन्क्रिप्टेड और सुरक्षित है। हम आपकी जानकारी कभी साझा नहीं करते।"

msgid "Why OTP?"
msgstr "OTP क्यों?"

msgid "OTP ensures only you can access this account"
msgstr "OTP सुनिश्चित करता है कि केवल आप ही इस खाते तक पहुंच सकते हैं"

msgid "Secure"
msgstr "सुरक्षित"

msgid "Military-grade encryption protects your account"
msgstr "सैन्य-स्तर का एन्क्रिप्शन आपके खाते की सुरक्षा करता है"

msgid "Quick"
msgstr "तेज़"

msgid "OTP is valid for 10 minutes from email delivery."
msgstr "ईमेल भेजे जाने के बाद OTP 10 मिनट तक मान्य है।"

msgid "You must be at least 18 years old to self-register."
msgstr "स्व-पंजीकरण के लिए आपकी आयु कम से कम 18 वर्ष होनी चाहिए।"

msgid "Profile photo must be less than 2MB."
msgstr "प्रोफाइल फोटो 2MB से कम होनी चाहिए।"

msgid "Choose a username"
msgstr "यूज़रनेम चुनें"

msgid "Enter your full name"
msgstr "अपना पूरा नाम दर्ज करें"

msgid "Enter email address"
msgstr "ईमेल पता दर्ज करें"

msgid "10-digit mobile number"
msgstr "10 अंकों का मोबाइल नंबर"

msgid "House no, street, landmark, area"
msgstr "मकान नंबर, सड़क, लैंडमार्क, क्षेत्र"

msgid "6-digit pincode"
msgstr "6 अंकों का पिनकोड"

msgid "Optional 12-digit Aadhaar number"
msgstr "वैकल्पिक 12 अंकों का आधार नंबर"
