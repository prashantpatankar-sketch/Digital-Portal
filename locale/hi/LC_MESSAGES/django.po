msgstr "मुझे 30 दिनों तक याद रखें"

msgid "Sign In"
msgstr "साइन इन"

msgid "Don't have an account?"
msgstr "क्या आपका खाता नहीं है?"

msgid "Register Now"
msgstr "अभी पंजीकरण करें"

msgid "Forgot Password?"
msgstr "पासवर्ड भूल गए?"

